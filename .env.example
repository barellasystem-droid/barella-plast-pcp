# Copie para .env (uso local) ou configure como variáveis de ambiente no
# painel da Vercel (Project Settings → Environment Variables).

# Connection string do Postgres do Supabase. Use o modo "Transaction pooler"
# (Project Settings → Database → Connection string → Transaction, porta 6543)
# — funções serverless abrem/fecham conexão a cada request, e o pooler evita
# esgotar o limite de conexões do Postgres.
DATABASE_URL=postgresql://postgres.xxxxxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Valor longo e aleatório — obrigatório quando NODE_ENV=production (o servidor
# recusa iniciar sem isso). Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Opcional: só defina se algum outro site/app for acessar esta API a partir de
# outro domínio. No uso normal (Vercel servindo tudo na mesma origem) não precisa.
# ALLOWED_ORIGIN=https://outro-dominio.com.br

# Opcional: chave da API do Resend (resend.com), usada para notificar por
# e-mail os usuários admin/PCP quando alguém cria uma Requisição de Material
# ou de Matéria-Prima. Sem essa variável, a notificação é simplesmente pulada
# (a requisição continua sendo criada normalmente).
RESEND_API_KEY=
# Opcional: remetente customizado (precisa de domínio verificado no Resend).
# Sem isso, usa o remetente de teste onboarding@resend.dev.
# RESEND_FROM=Barella Plast PCP <notificacoes@seudominio.com.br>
